#User Section
USERS=/users
USER=/user
TICKET=/tickets
USER_PROFILE=/user/profile
USER_PROFILE_IMAGE = /user/profile/image
LOGOUT=/logout

#Authentication Section
REGISTER=/register
LOGIN=/login
LOGIN_GOOGLE=/login/google/token
