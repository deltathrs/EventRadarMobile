BASE_URL=https://api.eventradar.cloud
BASE_URL_IMAGE=https://eventradar.cloud

# Define API endpoints

#Event Section
EVENT=/event
AD_SLIDER=/adslider
EVENTS=/events
BUY_TICKET=/buy
FAVOURITE=/favourites
TICKET=/tickets
LIST_EO=/speakers

#Event Organizer Section
MY_EVENT=/MyEvents
